{% if show_watermark %}
<script>document.documentElement.classList.add('dds-preview-watermark');</script>
{% endif %}
<div class="dds-share card my-4">
  <div class="card-body">
    <div class="row g-3 align-items-center">
      {% if thumb %}
        <div class="col-sm-4 col-lg-3">
          <div class="dds-share__preview">
            <img src="{{ thumb }}" alt="{{ product_name }}" class="img-fluid rounded"/>
            {% if show_watermark %}<span class="dds-share__stamp">{{ watermark_text }}</span>{% endif %}
          </div>
        </div>
      {% endif %}
      <div class="col">
        <h5 class="dds-share__heading mb-1">{{ heading }}</h5>
        {% if intro %}<p class="text-muted small mb-3">{{ intro }}</p>{% endif %}
        <div class="d-flex flex-wrap gap-2">
          {% for network in networks %}
            <a href="{{ network.href }}" class="btn btn-sm btn-{{ network.class }}" target="_blank" rel="noopener nofollow">{{ network.name }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
    {% if affiliate_url %}
      <hr/>
      <label class="form-label small fw-bold" for="dds-affiliate-url">{{ text_affiliate }}</label>
      <div class="input-group input-group-sm">
        <input type="text" id="dds-affiliate-url" class="form-control" value="{{ affiliate_url }}" readonly onclick="this.select();"/>
        <button type="button" id="dds-copy-affiliate" class="btn btn-outline-secondary" data-copied="{{ text_copied }}">{{ text_copy }}</button>
      </div>
    {% endif %}
  </div>
</div>
<script type="text/javascript"><!--
(function () {
    var button = document.getElementById('dds-copy-affiliate');

    if (!button) {
        return;
    }

    button.addEventListener('click', function () {
        var input = document.getElementById('dds-affiliate-url');

        if (!input) {
            return;
        }

        input.select();

        var done = function () {
            button.textContent = button.getAttribute('data-copied');
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(input.value).then(done, done);
        } else {
            try {
                document.execCommand('copy');
                done();
            } catch (e) {}
        }
    });
})();
//--></script>
